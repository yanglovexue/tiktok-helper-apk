<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#1a1a2e">

    <!-- 标题 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TikTok 自动化工具"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#e94560"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp" />

    <!-- 状态 -->
    <TextView
        android:id="@+id/tv_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="状态: 已停止 🔴"
        android:textSize="16sp"
        android:textColor="#ffffff"
        android:layout_marginBottom="20dp" />

    <!-- 功能开关 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <CheckBox
            android:id="@+id/cb_like"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="自动点赞"
            android:textColor="#ffffff"
            android:checked="true" />

        <CheckBox
            android:id="@+id/cb_comment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="自动评论"
            android:textColor="#ffffff"
            android:checked="true" />
    </LinearLayout>

    <!-- 点赞概率 -->
    <TextView
        android:id="@+id/tv_like_chance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="点赞概率: 70%"
        android:textColor="#cccccc"
        android:layout_marginBottom="4dp" />

    <SeekBar
        android:id="@+id/sb_like_chance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100"
        android:progress="70"
        android:layout_marginBottom="16dp" />

    <!-- 评论概率 -->
    <TextView
        android:id="@+id/tv_comment_chance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="评论概率: 20%"
        android:textColor="#cccccc"
        android:layout_marginBottom="4dp" />

    <SeekBar
        android:id="@+id/sb_comment_chance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100"
        android:progress="20"
        android:layout_marginBottom="16dp" />

    <!-- 评论内容 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="引流评论内容（每行一条）:"
        android:textColor="#cccccc"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/et_comments"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="#16213e"
        android:textColor="#ffffff"
        android:textSize="12sp"
        android:gravity="top"
        android:padding="8dp"
        android:inputType="textMultiLine"
        android:layout_marginBottom="20dp" />

    <!-- 控制按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btn_start"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="▶ 启动"
            android:backgroundTint="#e94560"
            android:textColor="#ffffff"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btn_stop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⏹ 停止"
            android:backgroundTint="#533483"
            android:textColor="#ffffff"
            android:enabled="false" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_open_tiktok"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📱 打开 TikTok"
        android:backgroundTint="#0f3460"
        android:textColor="#ffffff" />

    <!-- 使用说明 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="使用说明:\n1. 开启无障碍服务\n2. 打开 TikTok 停在首页\n3. 配置评论内容和概率\n4. 点击启动开始自动化"
        android:textSize="11sp"
        android:textColor="#888888"
        android:layout_marginTop="20dp"
        android:lineSpacingExtra="4dp" />

</LinearLayout>
